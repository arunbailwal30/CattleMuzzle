":"<Figure size 1600x1000 with 5 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"\n============================================================\nCOMPREHENSIVE PERFORMANCE METRICS SUMMARY\n============================================================\n\n1. COSINE SIMILARITY METRICS:\n   Known cattle - Mean: 0.5296 ± 0.1091\n   Unknown cattle - Mean: 0.4699 ± 0.1076\n   Separation: 0.0597\n\n2. ROC/AUC METRICS:\n   AUC Score: 0.6595\n   Optimal Threshold: 0.4430\n   TPR at Optimal: 0.7577\n   FPR at Optimal: 0.4146\n\n3. FRR/FAR METRICS:\n   EER (Equal Error Rate): 0.3679\n   EER Threshold: 0.4800\n   FRR at EER: 0.3700\n   FAR at EER: 0.3659\n\n4. ACCURACY METRICS:\n   Best Accuracy: 0.8507\n   At Threshold: 0.3200\n============================================================\n","output_type":"stream"}],"execution_count":38},{"cell_type":"code","source":"\n# Grad-CAM Implementation\nimport cv2\nfrom torch.nn import functional as F\n\nclass GradCAM:\n    def __init__(self, model, target_layer):\n        self.model = model\n        self.target_layer = target_layer\n        self.gradients = None\n        self.activations = None\n        \n        # Register hook to capture gradients and activations\n        self.target_layer.register_forward_hook(self.save_activation)\n        self.target_layer.register_full_backward_hook(self.save_gradient)\n    \n    def save_activation(self, module, input, output):\n        self.activations = output.detach()\n    \n    def save_gradient(self, module, grad_input, grad_output):\n        self.gradients = grad_output[0].detach()\n    \n    def generate_cam(self, input_tensor, class_idx=None):\n        # Forward pass to get features\n        self.model.eval()\n        with torch.no_grad():\n            output = self.model(input_tensor)\n            # Handle both cases: features only or (features, logits)\n            if isinstance(output, tuple):\n                features, logits = output\n            else:\n                features = output\n                logits = None\n        \n        # If we only have features, we need to compute logits\n        if logits is None:\n            # Create dummy labels to get logits\n            batch_size = input_tensor.size(0)\n            dummy_labels = torch.zeros(batch_size, dtype=torch.long, device=input_tensor.device)\n            features_with_labels, logits = self.model(input_tensor, dummy_labels)\n        \n        # Get class index if not provided\n        if class_idx is None:\n            class_idx = logits.argmax(dim=1).item()\n        \n        # Backward pass\n        target = logits[:, class_idx]\n        self.model.zero_grad()\n        target.backward()\n        \n        # Calculate Grad-CAM\n        gradients = self.gradients[0]  # (C, H, W)\n        activations = self.activations[0]  # (C, H, W)\n        \n        # Weighted combination of activation maps\n        weights = gradients.mean(dim=(1, 2))  # (C,)\n        cam = torch.zeros(activations.shape[1:], device=activations.device)\n        \n        for i, w in enumerate(weights):\n            cam += w * activations[i]\n        \n        cam = F.relu(cam)\n        cam = cam / (cam.max() + 1e-8)\n        \n        return cam.cpu().numpy(), class_idx\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-22T10:38:11.938447Z","iopub.execute_input":"2026-06-22T10:38:11.938759Z","iopub.status.idle":"2026-06-22T10:38:11.948446Z","shell.execute_reply.started":"2026-06-22T10:38:11.938720Z","shell.execute_reply":"2026-06-22T10:38:11.947583Z"}},"outputs":[],"execution_count":39},{"cell_type":"code","source":"\nmodel.eval()\ngrad_cam = GradCAM(model, model.backbone[-2]) # get last layer\n\nnum_samples = 2\nfig, axes = plt.subplots(num_samples, 3, figsize=(15, 4 * num_samples))\n\nfor idx in range(num_samples):\n    rand_idx = np.random.randint(0, len(test_dataset))\n    img_tensor, label = test_dataset[rand_idx]\n    \n    img_batch = img_tensor.unsqueeze(0).to(device)\n    \n    cam, pred_class = grad_cam.generate_cam(img_batch, class_idx=int(label.item()))\n    \n    # Convert tensor back to image for visualization\n    img_display = img_tensor.permute(1, 2, 0).cpu().numpy()\n    cam_resized = cv2.resize(cam, (img_display.shape[1], img_display.shape[0]))\n    \n    # Create heatmap\n    heatmap = cv2.applyColorMap((cam_resized * 255).astype(np.uint8), cv2.COLORMAP_JET)\n    heatmap = cv2.cvtColor(heatmap, cv2.COLOR_BGR2RGB)\n    heatmap = heatmap / 255.0\n    \n    # Ensure both arrays are float32 for proper blending\n    img_display = img_display.astype(np.float32)\n    heatmap = heatmap.astype(np.float32)\n    \n    # Overlay heatmap on original image\n    overlay = cv2.addWeighted(img_display, 0.6, heatmap, 0.4, 0)\n    \n    # Plot original image\n    axes[idx, 0].imshow(img_display)\n    axes[idx, 0].set_title(f'Original Image\\n(Label: {label.item()})', fontsize=10)\n    axes[idx, 0].axis('off')\n    \n    # Plot Grad-CAM heatmap\n    im = axes[idx, 1].imshow(cam_resized, cmap='jet')\n    axes[idx, 1].set_title(f'Grad-CAM Heatmap\\n(Pred: {pred_class})', fontsize=10)\n    axes[idx, 1].axis('off')\n    plt.colorbar(im, ax=axes[idx, 1], fraction=0.046, pad=0.04)\n    \n    # Plot overlay\n    axes[idx, 2].imshow(overlay)\n    axes[idx, 2].set_title('Grad-CAM Overlay', fontsize=10)\n    axes[idx, 2].axis('off')\n\nplt.tight_layout()\nplt.savefig('GradCAM_Visualization.jpg', dpi=150, bbox_inches='tight')\nplt.show()\nplt.close()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-22T10:38:11.949574Z","iopub.execute_input":"2026-06-22T10:38:11.949950Z","iopub.status.idle":"2026-06-22T10:38:13.531938Z","shell.execute_reply.started":"2026-06-22T10:38:11.949916Z","shell.execute_reply":"2026-06-22T10:38:13.529943Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1500x800 with 8 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":40},{"cell_type":"markdown","source":"","metadata":{}},{"cell_type":"code","source":"# Few-Shot Learning with Prototypical Networks\nimport torch\nimport torch.nn.functional as F\nfrom sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score\n\nclass PrototypicalNetworks:\n    \"\"\"\n    Few-shot learning using Prototypical Networks.\n    Learns to classify based on distances to class prototypes (centroids).\n    \"\"\"\n    def __init__(self, model, device):\n        self.model = model\n        self.device = device\n        self.prototypes = {}\n        self.class_ids = []\n    \n    def compute_prototypes(self, support_loader):\n        \"\"\"Compute class prototypes (centroids) from support set\"\"\"\n        self.model.eval()\n        self.prototypes = {}\n        all_features = {}\n        all_labels = {}\n        \n        with torch.no_grad():\n            for images, labels in support_loader:\n                images = images.to(self.device)\n                features = self.model(images)  # (batch, 512)\n                features = F.normalize(features, p=2, dim=1)\n                \n                for i, label in enumerate(labels):\n                    label_idx = int(label.item())\n                    if label_idx not in all_features:\n                        all_features[label_idx] = []\n                        all_labels[label_idx] = label_idx\n                    all_features[label_idx].append(features[i])\n        \n        # Compute prototypes as mean of features per class\n        for label_idx, feats in all_features.items():\n            features_tensor = torch.stack(feats)\n            prototype = features_tensor.mean(dim=0)\n            self.prototypes[label_idx] = F.normalize(prototype.unsqueeze(0), p=2, dim=1).squeeze(0)\n            self.class_ids.append(label_idx)\n        \n        self.class_ids = sorted(self.class_ids)\n        print(f\"Computed prototypes for {len(self.prototypes)} classes\")\n        return self.prototypes\n    \n    def predict(self, query_loader, use_cosine_distance=True, return_confidence=False):\n        self.model.eval()\n        predictions = []\n        true_labels = []\n        confidences = []\n        distances_all = []\n        \n        if not self.prototypes:\n            raise ValueError(\"Prototypes not computed. Call compute_prototypes first.\")\n        \n        with torch.no_grad():\n            for images, labels in query_loader:\n                images = images.to(self.device)\n                features = self.model(images) \n                features = F.normalize(features, p=2, dim=1)\n                \n                # Compute distances to all prototypes\n                prototype_tensors = torch.stack([self.prototypes[cid] for cid in self.class_ids])\n                \n                if use_cosine_distance:\n                    # Cosine similarity (higher is better)\n                    distances = torch.mm(features, prototype_tensors.t())  # (batch, num_classes)\n                    distances = 1 - distances  # Convert to distance (lower is better)\n                else:\n                    # Euclidean distance\n                    distances = torch.cdist(features, prototype_tensors)\n                \n                distances_all.append(distances.cpu().numpy())\n                \n                # Predict class with closest prototype\n                pred_indices = torch.argmin(distances, dim=1)\n                preds = torch.tensor([self.class_ids[idx] for idx in pred_indices])\n                \n                # Confidence: inverse of normalized distance\n                min_distances = distances.min(dim=1).values\n                confidence = (1 - min_distances).cpu().numpy()\n                \n                predictions.extend(preds.cpu().numpy())\n                true_labels.extend(labels.cpu().numpy())\n                confidences.extend(confidence)\n        \n        predictions = np.array(predictions)\n        true_labels = np.array(true_labels)\n        confidences = np.array(confidences)\n        distances_all = np.concatenate(distances_all, axis=0)\n        \n        if return_confidence:\n            return predictions, true_labels, confidences, distances_all\n        return predictions, true_labels\n    \n    def evaluate(self, query_loader):\n        preds, true_labels, confidences, distances = self.predict(query_loader, return_confidence=True)\n        \n        accuracy = accuracy_score(true_labels, preds)\n        precision = precision_score(true_labels, preds, average='weighted', zero_division=0)\n        recall = recall_score(true_labels, preds, average='weighted', zero_division=0)\n        f1 = f1_score(true_labels, preds, average='weighted', zero_division=0)\n        \n        return {\n            'accuracy': accuracy,\n            'precision': precision,\n            'recall': recall,\n            'f1': f1,\n            'predictions': preds,\n            'labels': true_labels,\n            'confidences': confidences,\n            'distances': distances\n        }\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-22T10:38:13.533002Z","iopub.execute_input":"2026-06-22T10:38:13.533305Z","iopub.status.idle":"2026-06-22T10:38:13.548755Z","shell.execute_reply.started":"2026-06-22T10:38:13.533280Z","shell.execute_reply":"2026-06-22T10:38:13.548060Z"}},"outputs":[{"name":"stdout","text":"Prototypical Networks Few-Shot Learning class defined\n","output_type":"stream"}],"execution_count":41},{"cell_type":"code","source":"\n# Evaluate Few-Shot Learning on Test Set\nfs_learner = PrototypicalNetworks(model, device)\n\n# Use training data as support set to compute prototypes\nfs_learner.compute_prototypes(train_loader)\n\n# Evaluate on test set\nprint(\"Evaluating Few-Shot Learning on Test Set...\")\nfs_results = fs_learner.evaluate(test_loader)\nprint(f\"Accuracy:  {fs_results['accuracy']:.4f}\")\nprint(f\"Precision: {fs_results['precision']:.4f}\")\nprint(f\"Recall:    {fs_results['recall']:.4f}\")\npri