":72},{"cell_type":"code","source":"def get_probabilities_and_labels(model, dataloader, device):\n    model.eval()\n    all_probs = []\n    all_labels = []\n    \n    with torch.no_grad():\n        for images, labels in dataloader:\n            images = images.to(device)\n            features = model(images)  \n            features = F.normalize(features)\n            class_weights = F.normalize(model.arc_margin.weight) \n            cosine = F.linear(features, class_weights)  \n            \n            probs = F.softmax(cosine, dim=1)\n            \n            all_probs.extend(probs.cpu().numpy())\n            all_labels.extend(labels.cpu().numpy())\n    \n    return np.array(all_probs), np.array(all_labels)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-26T14:11:52.998236Z","iopub.execute_input":"2026-06-26T14:11:52.999256Z","iopub.status.idle":"2026-06-26T14:11:53.005070Z","shell.execute_reply.started":"2026-06-26T14:11:52.999213Z","shell.execute_reply":"2026-06-26T14:11:53.004153Z"}},"outputs":[],"execution_count":73},{"cell_type":"code","source":"test_probs, test_labels = get_probabilities_and_labels(model, test_loader, device)\nfrom sklearn.metrics import roc_auc_score\n\nroc_auc = roc_auc_score(\n    test_labels, \n    test_probs, \n    multi_class='ovr',   \n    average='macro'    \n)\n\nprint(f\"ROC AUC score : {roc_auc:.4f}\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-26T14:11:55.511348Z","iopub.execute_input":"2026-06-26T14:11:55.511640Z","iopub.status.idle":"2026-06-26T14:11:56.625801Z","shell.execute_reply.started":"2026-06-26T14:11:55.511615Z","shell.execute_reply":"2026-06-26T14:11:56.624908Z"}},"outputs":[{"name":"stdout","text":"ROC AUC score : 0.9995\n","output_type":"stream"}],"execution_count":74},{"cell_type":"markdown","source":"**Creating prototype gallery**","metadata":{}},{"cell_type":"code","source":"\nprototype_dataset = ImageDataset(x_train, labels=y_train, augment=False)\nprototype_l